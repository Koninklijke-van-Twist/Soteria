<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!--
        sleutels.kvt.nl stuurt alleen het servercertificaat mee, zonder de Sectigo
        intermediate. Browsers halen die schakel zelf op, Android doet dat niet.
        De intermediate staat daarom hier als extra anchor, naast de systeemanchors
        zodat een volledige keten later gewoon blijft werken.
    -->
    <domain-config>
        <domain includeSubdomains="true">kvt.nl</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/sectigo_ca_dv_r36" />
        </trust-anchors>
    </domain-config>
</network-security-config>
